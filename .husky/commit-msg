#!/bin/sh

# Validate commit message format
# This is a basic example - you can enhance it with more rules

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Check if commit message is not empty
if [ -z "$(echo "$commit_msg" | sed 's/^[[:space:]]*$//')" ]; then
    echo "✗ Commit message cannot be empty"
    exit 1
fi

# Check minimum length (optional)
if [ ${#commit_msg} -lt 3 ]; then
    echo "✗ Commit message must be at least 3 characters"
    exit 1
fi

echo "✓ Commit message is valid"
